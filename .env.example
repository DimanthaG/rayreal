# ── Backend API (the rayreal-backend repo, on Render). Leave empty for demo mode (empty in-browser store). ──
VITE_API_BASE_URL=https://api.rayrealtysl.com

# ── Public site details ──
VITE_SITE_URL=https://www.rayrealtysl.com
# Default WhatsApp / call number (international format, digits only). Listings can override it.
VITE_WHATSAPP_NUMBER=94777727527
VITE_PHONE_NUMBER=+94777727527
VITE_CONTACT_EMAIL=sales@raytronics.lk

# ── Firebase web config (Project settings → General → Your apps). Safe to expose. ──
# Used only for admin login (Firebase Auth). Photos are stored on Cloudinary via the API.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: Google Maps Embed API key. Without it, maps use the keyless embed.
VITE_GOOGLE_MAPS_EMBED_KEY=

# Build-time only: set to "true" to use #/hash URLs (static previews without rewrites)
VITE_HASH_ROUTER=false
